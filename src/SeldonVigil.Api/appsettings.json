{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=seldonvigil;Username=postgres;Password=dev_password",
      "PostgreSQL": "Host=localhost;Database=seldonvigil;Username=postgres;Password=dev_password",
      "Redis": "localhost:6379",
      "Broker": "127.0.0.1:9092"
      },
  "Broker": {
    "ConsumerGroup": "seldonvigil"
  },
  "OpenAI": {
    "ApiKey": ""
  },
  "Identity": {
    "Token": {
      "Issuer": "seldonvigil-prod",
      "Audience": "seldonvigil-api",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 7
    },
    "AllowRegistration": false
  },
  "DevAuth": {
    "Enabled": false,
    "SecretKey": "ThisIsADevelopmentSecretKeyThatShouldBeChangedInProduction!",
    "Issuer": "seldonvigil-dev",
    "Audience": "seldonvigil-api"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "QueueLimit": 10,
    "ReplenishmentPeriodSeconds": 1,
    "TokensPerPeriod": 10,
    "Auth": {
      "TokenLimit": 10,
      "QueueLimit": 2,
      "ReplenishmentPeriodSeconds": 60,
      "TokensPerPeriod": 5
    },
    "Write": {
      "TokenLimit": 30,
      "QueueLimit": 5,
      "ReplenishmentPeriodSeconds": 1,
      "TokensPerPeriod": 5
    }
  }
}
