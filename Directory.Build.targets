<Project>
  <!--
    Suppress analyzer style/design findings in the application and test projects.

    These projects are not shipped, so the analyzer rule set is noise there. The
    packaged libraries (SeldonVigil.Sdk, SeldonVigil.Telemetry) keep the full rule set so
    their public API stays clean.

    This file is imported after the project body, so it also wins over any
    <NoWarn> defined in an individual .csproj.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'SeldonVigil.Sdk' And '$(MSBuildProjectName)' != 'SeldonVigil.Telemetry'">
    <NoWarn>$(NoWarn);CA1001;CA1002;CA1031;CA1032;CA1050;CA1062;CA1063;CA1303;CA1305;CA1307;CA1308;CA1310</NoWarn>
    <NoWarn>$(NoWarn);CA1508;CA1515;CA1707;CA1716;CA1724;CA1802;CA1812;CA1816;CA1819;CA1822;CA1825</NoWarn>
    <NoWarn>$(NoWarn);CA1826;CA1849;CA1851;CA1852;CA1854;CA1859;CA1860;CA1861;CA1865;CA1869;CA2000</NoWarn>
    <NoWarn>$(NoWarn);CA2007;CA2016;CA2201;CA2234;CA5394;IL2026;IL2046;IL2057;IL2075;IL2090;IL2123</NoWarn>
    <NoWarn>$(NoWarn);IL3050;IL3051;IL3057;S1006;S101;S1075;S1118;S1144;S1172;S1199;S125;S1450</NoWarn>
    <NoWarn>$(NoWarn);S1481;S1905;S1994;S2139;S2325;S3358;S3398;S3453;S3881;S3903;S4487;S6444</NoWarn>
    <NoWarn>$(NoWarn);S6562;S6580;S6608;S6667;S6966;S8949;S8969;S927</NoWarn>
    <!-- CS0436 is the benign collision between the Workers' generated entry-point
         type and SeldonVigil.Api.Program. Nullable reference warnings are deliberately
         NOT suppressed: they are real defects and are fixed in place. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
</Project>
