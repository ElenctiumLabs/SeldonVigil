# infrastructure/docker/Dockerfile.frontend
# Build stage - web app
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Build stage - documentation viewer (reads docs/ and inlines it into the bundle)
FROM node:22-alpine AS docs
WORKDIR /app/tools/docs-viewer
COPY tools/docs-viewer/package.json tools/docs-viewer/package-lock.json ./
RUN npm ci
COPY tools/docs-viewer/ ./
COPY docs/ /app/docs/
RUN npm run build

# Serve stage
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=docs /app/tools/docs-viewer/dist /usr/share/nginx/html/docs-viewer
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
