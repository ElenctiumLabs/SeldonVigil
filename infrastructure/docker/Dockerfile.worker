# infrastructure/docker/Dockerfile.worker
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json ./
COPY src/SeldonVigil.SharedKernel/ src/SeldonVigil.SharedKernel/
COPY src/SeldonVigil.SourceGenerators/ src/SeldonVigil.SourceGenerators/
COPY src/SeldonVigil.Telemetry/ src/SeldonVigil.Telemetry/
COPY src/SeldonVigil.Sdk/ src/SeldonVigil.Sdk/
COPY src/SeldonVigil.Api/ src/SeldonVigil.Api/
COPY src/SeldonVigil.Workers/ src/SeldonVigil.Workers/

RUN rm -f src/SeldonVigil.Api/appsettings*.json

RUN dotnet restore src/SeldonVigil.Workers/SeldonVigil.Workers.csproj --locked-mode -r linux-x64

RUN dotnet publish src/SeldonVigil.Workers/SeldonVigil.Workers.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    -p:StripSymbols=true \
    -p:InvariantGlobalization=true

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

RUN useradd --no-create-home --shell /usr/sbin/nologin appuser

WORKDIR /app
COPY --from=build /app/publish .
RUN chown -R appuser:appuser /app

USER appuser

# Health check — verify main process (PID 1) is still alive
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD ["bash", "-c", "kill -0 1 || exit 1"]

ENTRYPOINT ["/app/SeldonVigil.Workers"]
