# Local development environment for SeldonVigil
# POSTGRES_PASSWORD matches the postgres superuser password (dev_password)
POSTGRES_PASSWORD=dev_password

# Dev auth authority (API runs on 5000/5001 by default; Kestrel TLS on 5001)
AUTHORITY=https://localhost:5001
AUDIENCE=seldonvigil-api

# Optional – AI features (leave blank or add your key)
OPENAI_API_KEY=
